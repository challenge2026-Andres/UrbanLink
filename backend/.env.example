# Copie este arquivo para .env e preencha os valores.
# O .env real NUNCA deve ser commitado (já está no .gitignore).

# Porta do servidor HTTP do backend
PORT=3333

# Ambiente: development | production
NODE_ENV=development

# Chave da API Olho Vivo da SPTrans (gerada em "Meus Aplicativos").
# Fica SOMENTE no backend. Nunca exponha no frontend.
SPTRANS_API_KEY=

# URL base da API da SPTrans (não precisa alterar)
SPTRANS_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1

# Origem permitida para CORS (URL do frontend Vite em dev)
CORS_ORIGIN=http://localhost:5173

# --- Validação de trajeto (Fase 3) ---

# Raio (metros) entre o celular e o ônibus mais próximo para o check-in valer.
VALIDATION_RADIUS_M=150

# Idade máxima (segundos) da captura de posição da SPTrans para ser confiável.
SPTRANS_POSITION_MAX_AGE_S=90

# Tamanho máximo (bytes) da foto enviada na validação. Padrão: 2 MiB.
MAX_PHOTO_BYTES=2097152

# APENAS DESENVOLVIMENTO: quando "true", toda validação de trajeto é aceita
# (útil para testar o fluxo no celular sem estar dentro de um ônibus).
# Ignorado automaticamente quando NODE_ENV=production.
VALIDATION_BYPASS=false
